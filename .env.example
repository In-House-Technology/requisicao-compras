# Variables the app reads. No real values here, ever.
# On the box, ihc-app provision writes the real file with PORT, APP_BASE_URL,
# DATABASE_URL (and PG*). LOCAL_* values are for a laptop only and never reach the box.
PORT=8080
APP_SLUG=requisicao-compras
# Banco compartilhado: defina DATABASE_URL ou as variáveis PG* fora do repositório.
LOCAL_AUTH_MOCK_EMAIL=dev@example.com
LOCAL_AUTH_MOCK_NAME=Pessoa de teste
LOCAL_AUTH_MOCK_GROUPS=ihc-users
